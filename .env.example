# Local dependency stack
POSTGRES_DB=psicogest
POSTGRES_USER=psicogest
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=jdbc:postgresql://localhost:5432/psicogest
DATABASE_USERNAME=psicogest
DATABASE_PASSWORD=change-me-local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:8080
VITE_DEMO_MODE=false

# Backend security — replace in every environment; never commit generated values.
JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem
JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem
JWT_KEY_ID=primary-2026
JWT_COOKIE_SECURE=false
MFA_ENCRYPTION_KEY=base64-32-byte-secret-generated-outside-git
CLINICAL_KEK=base64-32-byte-secret-generated-outside-git
AUDIT_HMAC_KEY=independent-base64-32-byte-secret-generated-outside-git
# Production only: separate migration credentials; runtime must use NOSUPERUSER NOBYPASSRLS.
MIGRATION_DATABASE_USERNAME=
MIGRATION_DATABASE_PASSWORD=
SECURITY_ALLOWED_ORIGINS=http://localhost:5173

# Optional incident sinks. Leave empty until the endpoint is configured and tested.
SECURITY_ALERT_EMAIL_ENDPOINT=
SECURITY_ALERT_CLOUD_MONITORING_ENDPOINT=
SECURITY_ALERT_PAGERDUTY_ENDPOINT=
SECURITY_ALERT_SIEM_ENDPOINT=
