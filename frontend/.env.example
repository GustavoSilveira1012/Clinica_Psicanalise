VITE_API_URL=http://localhost:8080
# Ative somente em ambientes de demonstração isolados; produção deve usar o backend real.
VITE_DEMO_MODE=false
# Production pilot UI defaults to clinical-only. The API has its own server-side gate.
VITE_CLINICAL_ONLY_PILOT=true
# In production, clinical access stays disabled until data and operational controls are approved.
VITE_CLINICAL_DATA_ENABLED=false
# Production requires a separate explicit release approval as well.
VITE_CLINICAL_DATA_RELEASE_APPROVED=false
